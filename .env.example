# Existing integrations
GEMINI_API_KEY=

INBOX_WATCHER_ENABLED=true
INBOX_POLL_SECONDS=30

# Burner Gmail
IMAP_HOST=imap.gmail.com
IMAP_USER=your-burner@gmail.com
IMAP_APP_PASSWORD=your-16-character-app-password

# Email classification
GROQ_API_KEY=gsk_your_key
TAVILY_API_KEY=tvly_your_key

# Structured interview analysis, topic generation, and reports use the same Groq key.
# Model: llama-3.3-70b-versatile

# Supabase backend access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fernet key to encrypt the LinkedIn session at rest in Supabase (Phase 2).
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required (together with SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY) to enable encrypted Supabase session storage.
SESSION_ENCRYPTION_KEY=

# Browser origin allowed to call the FastAPI email-service routes
FRONTEND_ORIGIN=http://localhost:3001
